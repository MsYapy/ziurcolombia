<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- IgniteUI Blazor Styles -->
    <link href="_content/IgniteUI.Blazor/themes/light/bootstrap.css" rel="stylesheet" />
    
    <!-- Custom Styles - ORDEN IMPORTANTE -->
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["css/pages/catalog.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["Ziur.styles.css"]" />
    
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    
    <!-- Initialize theme BEFORE any content renders -->
    <script>
        (function() {
            // Get saved theme or default to light
            const savedTheme = localStorage.getItem('theme') || 'light';
            
            // Apply to document immediately
            document.documentElement.setAttribute('data-theme', savedTheme);
            
            // Apply IgniteUI theme
            if (savedTheme === 'dark') {
                const link = document.querySelector('link[href*="light/bootstrap.css"]');
                if (link) {
                    link.href = link.href.replace('/light/', '/dark/');
                }
            }
            
            // Make theme available globally
            window.currentTheme = savedTheme;
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    
    <!-- IgniteUI Blazor Scripts -->
    <script src="_content/IgniteUI.Blazor/app.bundle.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

